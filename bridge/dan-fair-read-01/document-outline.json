      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4948,
      "endIndex": 5227,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Payment question to resolve — The advisor proposed investigating whether community members could pay instructors directly if university payment is complicated. This is unverified; obtain official university/ASSU guidance before representing it as allowed or collecting payments.",
      "protectedControls": []
    },
