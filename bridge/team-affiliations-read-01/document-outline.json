      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Coordinates everyone and oversees club activities. Next: settle open owners, provide confirmed event/class details, and coordinate the leadership handoff.",
      "protectedControls": []
