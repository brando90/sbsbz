      "endIndex": 362,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Next social: Oct 2, 2026, 8 PM–1 AM (ends the next day), Hacienda Commons, DJ Nokturnal. Funding and allowable costs remain unconfirmed. [Event page](https://partiful.com/e/ohtSD9MnHe6u71JQx60X)",
      "protectedControls": []
    },
