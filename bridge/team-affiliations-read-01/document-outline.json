      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Updated Sep 13, 2026. Current assignments from the president; “to agree” means a proposed next step, not an accepted commitment. Formal officer registration/eligibility has not been checked.",
      "protectedControls": []
    },
