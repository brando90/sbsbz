    },
    {
      "paragraphId": "P00063",
      "path": "tabs.t.0.body.content[63]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4428,
      "endIndex": 5320,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Leila shared insights on running a successful student dance club, specifically to help with the transition of leadership for the Bachata and Zouk club at Stanford. Leila shared her experience with the Tango Club, detailing how they recruited members through club fairs, Instagram, and Richard Powers' dance classes. She explained the challenges of space reservation, budgeting, and university policies regarding community participation and fundraising. Leila described the informal leadership structure of the Tango Club, emphasizing that members joined out of passion for the dance rather than for resume-building. She also discussed the time commitment for leadership, which was mostly upfront work at the start of each quarter. The conversation covered communication methods, such as email and WhatsApp, and the importance of finding committed individuals to ensure the club's continuity.",
      "protectedControls": []
    },
